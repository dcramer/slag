{
  "name": "slag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based competitive party platformer with procedurally generated levels, props, and characters.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxlint --fix && oxfmt src tests tools app next.config.ts instrumentation.ts instrumentation-client.ts vitest.config.ts",
    "format:check": "oxfmt --check src tests tools app next.config.ts instrumentation.ts instrumentation-client.ts vitest.config.ts",
    "test": "vitest run",
    "test:stats": "vitest run --mode stats",
    "test:store": "tsx tools/store-test.ts",
    "check:fast": "tsc --noEmit && pnpm lint && pnpm format:check",
    "check": "pnpm check:fast && pnpm test",
    "shot": "tsx tools/shot.ts",
    "brand": "tsx tools/brand.ts",
    "level": "tsx tools/level.ts",
    "online-test": "tsx tools/online-test.ts",
    "perf": "tsx tools/perf.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@sentry/browser": "^11.10.0",
    "@sentry/nextjs": "^11.10.0",
    "client-only": "^0.0.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.28.0"
}
