{
  "name": "slag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based competitive party platformer with procedurally generated levels, props, and characters.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src tests tools",
    "format": "biome check --write src tests tools",
    "check": "tsc --noEmit && biome check src tests tools && vitest run",
    "shot": "tsx tools/shot.ts",
    "level": "tsx tools/level.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
